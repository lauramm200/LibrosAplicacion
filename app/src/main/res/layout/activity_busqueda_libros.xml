<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <!-- TITULO + BOTÓN PERFIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTituloBusqueda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/titulo_busqueda"
                android:textColor="@color/marron"
                android:textSize="28sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPerfilHeader"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/btn_mi_perfil"
                app:icon="@drawable/ic_perfil"
                app:iconSize="28dp"
                app:iconTint="@color/marron" />
        </LinearLayout>

        <!-- BARRA DE BUSQUEDA -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscar"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_buscar"
            app:boxStrokeColor="@color/verde"
            app:endIconMode="clear_text"
            app:hintTextColor="@color/verde"
            app:startIconDrawable="@drawable/ic_buscar"
            app:startIconTint="@color/verde">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/marron" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- FILTROS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFiltros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodos"
                    style="@style/Chip.Libros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/chip_todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNovela"
                    style="@style/Chip.Libros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_novela" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFantasia"
                    style="@style/Chip.Libros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_fantasia" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHistoria"
                    style="@style/Chip.Libros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_historia" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- CABECERA -->
        <TextView
            android:id="@+id/tvResultados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/resultados"
            android:textColor="@color/marron"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- LISTA DE RESULTADOS -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResultados"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_libro_busqueda" />
    </LinearLayout>

    <!-- BARRA INFERIOR reutilizada -->
    <include
        android:id="@+id/barraInferior"
        layout="@layout/barra_inferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>