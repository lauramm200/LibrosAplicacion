<?xml version="1.0" encoding="utf-8"?>
<!-- FILA DE UN RESULTADO: el RecyclerView la repetira una vez por libro.
     Raiz = tarjeta blanca; margen inferior para separar una fila de otra. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <!-- Fila interior: portada a la izquierda, datos a la derecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- PORTADA (se cargara desde la API; el fondo amarillo es el marcador) -->
        <ImageView
            android:id="@+id/ivPortada"
            android:layout_width="64dp"
            android:layout_height="96dp"
            android:background="@color/amarillo"
            android:contentDescription="@string/desc_portada"
            android:scaleType="centerCrop" />

        <!-- Columna de datos; width=0dp + weight=1 = ocupa el espacio restante -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Titulo (maximo 2 lineas; si es mas largo se corta con "...") -->
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/marron"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Cien años de soledad" />

            <!-- Autor -->
            <TextView
                android:id="@+id/tvAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/verde"
                android:textSize="14sp"
                tools:text="Gabriel García Márquez" />

            <!-- Paginas -->
            <TextView
                android:id="@+id/tvPaginas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/marron"
                android:textSize="12sp"
                tools:text="471 págs." />

            <!-- BOTONES: dos al 50%. insetTop/insetBottom = 0 quita el margen
                 invisible que Material anade y permite botones bajos de 40dp. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuieroLeer"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/naranja"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/btn_quiero_leer"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLeido"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/verde"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/btn_leido"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>