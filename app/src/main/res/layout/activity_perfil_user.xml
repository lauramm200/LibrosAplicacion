<?xml version="1.0" encoding="utf-8"?>
<!-- RAIZ: igual que en las otras pantallas (ScrollView, fondo crema, id "main") -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:fillViewport="true">

    <!-- COLUMNA principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- SALUDO (nombre dinamico) -->
        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/marron"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Hola, Lau" />

        <!-- LECTOR DESDE (ano dinamico) -->
        <TextView
            android:id="@+id/tvLectorDesde"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/verde"
            android:textSize="16sp"
            tools:text="Lector desde 2026" />

        <!-- FILA DE CONTADORES: tres tarjetas, cada una width=0dp + weight=1 (un tercio del ancho) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <!-- Contador LEIDOS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Numero de libros (dato dinamico) -->
                    <TextView
                        android:id="@+id/tvNumLeidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/verde"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvEtiquetaLeidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/etiqueta_leidos"
                        android:textColor="@color/marron"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contador LEYENDO (margen a ambos lados porque esta en el centro) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNumLeyendo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/naranja"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvEtiquetaLeyendo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/etiqueta_leyendo"
                        android:textColor="@color/marron"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contador POR LEER -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvNumPorLeer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/marron"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvEtiquetaPorLeer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/etiqueta_por_leer"
                        android:textColor="@color/marron"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- TARJETA DE LA GRAFICA -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Titulo de la grafica -->
                <TextView
                    android:id="@+id/tvTituloGrafica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_tasa_mensual"
                    android:textColor="@color/marron"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- CONTENEDOR DE BARRAS: altura fija de 200dp, 6 columnas iguales.
                     Cada <include> reutiliza item_barra_mes.xml; se le da un id propio
                     (barra1..barra6) para poder acceder a cada una desde Kotlin.
                     Es obligatorio indicar layout_width y layout_height en el include
                     para que sus atributos de tamano/peso se apliquen. -->
                <LinearLayout
                    android:id="@+id/llGrafica"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/barra1"
                        layout="@layout/item_barra_mes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/barra2"
                        layout="@layout/item_barra_mes"                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/barra3"
                        layout="@layout/item_barra_mes"                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/barra4"
                        layout="@layout/item_barra_mes"                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/barra5"
                        layout="@layout/item_barra_mes"                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/barra6"
                        layout="@layout/item_barra_mes"                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- MEDIA mensual (dato dinamico) -->
                <TextView
                    android:id="@+id/tvMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/verde"
                    android:textSize="14sp"
                    tools:text="Páginas leídas por mes · media: 430 págs./mes" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>